BOT_TOKEN=your_telegram_bot_token_here
PORT=3000
MONGO_URI=your_mongodb_connection_string_here
GROUP_CHAT_ID=-100xxxxxxxxxx
# ID số Telegram của quản trị viên được phép dùng /scam và /testnews.
ADMIN_USER_IDS=
MUABAN_TOPIC_IDS=123,456
# Mặc định không tự khóa chat thành viên mới; đặt true nếu cần xác minh khi vào nhóm.
ENABLE_JOIN_CAPTCHA=false
# Topic nhận bản tin (để trống nếu gửi vào sảnh chung)
NEWS_TOPIC_ID=
# Render tự cung cấp RENDER_EXTERNAL_URL. Để trống khi chạy local bằng polling.
WEBHOOK_URL=
# Bảo vệ /cron/news: gửi header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Cầu nối thử nghiệm: giữ webhook hiện tại; Muse kéo công việc qua MCP.
# Chỉ bật sau khi đã kết nối và thử tác vụ Muse. Không đưa key thật lên GitHub.
MUSE_ENABLED=false
MUSE_ALLOWED_USER_IDS=
# 32 byte ngẫu nhiên, mã hóa hex (64 ký tự). Dùng Bearer auth trên /muse/mcp.
MUSE_BRIDGE_KEY=
